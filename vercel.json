{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/frontend/login.html" },
    { "source": "/login", "destination": "/frontend/login.html" },
    { "source": "/signup", "destination": "/frontend/signup.html" },
    { "source": "/cashbooks", "destination": "/frontend/cashbooks.html" },
    { "source": "/add-cashbook", "destination": "/frontend/add-cashbook.html" },
    { "source": "/cashbook-detail", "destination": "/frontend/cashbook-detail.html" },
    { "source": "/superadmin", "destination": "/frontend/superadmin.html" },
    { "source": "/((?!_vercel).*)", "destination": "/frontend/$1" }
  ]
}
