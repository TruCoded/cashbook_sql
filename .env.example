# Same names as the Vercel Environment Variables you already have in Cashbook.
# For local development copy this file to .env.local and fill it in.

GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your-16-letter-app-password
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGODB_DB_NAME=cashbook        # lowercase - must match the existing database name exactly

# Optional (any long random text). Signs OTP codes and login sessions.
# Falls back to a key derived from GMAIL_APP_PASSWORD.
OTP_SECRET=
