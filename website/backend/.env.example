MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=cashbook
GMAIL_USER=your-sender@gmail.com
GMAIL_APP_PASSWORD=replace-with-new-google-app-password
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=replace-with-a-random-secret-of-at-least-32-characters
PORT=5000
# Optional, for website Google sign-in; must match the frontend OAuth client ID.
GOOGLE_CLIENT_ID=
